{
  "commands": [
    {
      "agent": null,
      "appendEnter": true,
      "autoClose": false,
      "command": "./Scripts/install-app.sh",
      "id": "install-app",
      "label": "部署到 Mac mini",
      "prompt": null,
      "type": "command",
      "workflowId": null
    }
  ],
  "preview": {
    "services": [
      {
        "bundleId": "local.routeweaver.mac",
        "command": [
          "bash",
          "-lc",
          "./Scripts/build-app.sh && (pkill -TERM -f \"[R]outeWeaver\\.app/Contents/MacOS/RouteWeaver\" || true; for i in $(seq 1 20); do pgrep -f \"[R]outeWeaver\\.app/Contents/MacOS/RouteWeaver\" >/dev/null || break; sleep 0.1; done; pkill -KILL -f \"[R]outeWeaver\\.app/Contents/MacOS/RouteWeaver\" || true) && open -g ./dist/RouteWeaver.app"
        ],
        "cwd": ".",
        "defaultPath": null,
        "dependsOn": [],
        "env": {
          "SKIP_TESTS": "1"
        },
        "healthPath": "/health",
        "id": "routeweaver",
        "kind": "macos-app",
        "name": "RouteWeaver",
        "port": {
          "args": [],
          "env": null,
          "fixed": null
        },
        "preferredPort": null,
        "readyTimeoutMs": 180000,
        "route": "direct",
        "source": "configured",
        "stop": [
          "bash",
          "-lc",
          "pkill -TERM -f \"$PWD/dist/RouteWeaver.app/Contents/MacOS/RouteWeaver\" || true; for i in $(seq 1 20); do pgrep -f \"$PWD/dist/RouteWeaver.app/Contents/MacOS/RouteWeaver\" >/dev/null || exit 0; sleep 0.1; done; pkill -KILL -f \"$PWD/dist/RouteWeaver.app/Contents/MacOS/RouteWeaver\" || true"
        ]
      },
      {
        "bundleId": "com.bytevela.routeweaver",
        "command": [
          "bash",
          "-lc",
          "./iOS/Scripts/build-ios-sim.sh"
        ],
        "cwd": ".",
        "defaultPath": null,
        "dependsOn": [],
        "device": "iPhone 18 Pro",
        "env": {},
        "healthPath": "/health",
        "id": "routeweaver-ios",
        "kind": "ios-simulator",
        "name": "RouteWeaver iOS",
        "port": {
          "args": [],
          "env": null,
          "fixed": null
        },
        "preferredPort": null,
        "readyTimeoutMs": 180000,
        "route": "direct",
        "source": "configured"
      }
    ],
    "version": 1
  }
}